        {
          "line": 7,
          "text": "class TorchDeterministicApiTestCase(TestCase):"
        },
        {
          "line": 8,
          "text": ""
        },
        {
          "line": 9,
          "text": "    def npu_op_exec(self, data, target, reduction):"
        },
        {
          "line": 10,
          "text": "        loss = torch.nn.NLLLoss2d(reduction=reduction)"
        },
        {
          "line": 11,
          "text": "        output = loss(data, target)"
        },
        {
          "line": 12,
          "text": "        output = output.to(\"cpu\")"
        },
        {
          "line": 13,
          "text": "        output = output.detach().numpy()"
        },
        {
          "line": 14,
          "text": "        return output"
        },
        {
          "line": 15,
          "text": ""
        },
        {
          "line": 16,
          "text": "    def test_npu_set_deterministic(self):"
        },
        {
          "line": 17,
          "text": "        torch.use_deterministic_algorithms(True)"
        },
        {
          "line": 18,
          "text": "        res = torch.are_deterministic_algorithms_enabled()"
        },
        {
          "line": 19,
          "text": "        self.assertEqual(res, True)"
        },
        {
          "line": 20,
          "text": ""
        },
        {
          "line": 21,
          "text": "        torch.use_deterministic_algorithms(False)"
        },
        {
          "line": 22,
          "text": "        res = torch.are_deterministic_algorithms_enabled()"
        },
        {
          "line": 23,
          "text": "        self.assertEqual(res, False)"
        },
        {
          "line": 24,
          "text": ""
        },
        {
          "line": 25,
          "text": ""
        },
        {
          "line": 26,
          "text": "def test_npu_set_deterministic_true():"
        },
        {
          "line": 27,
          "text": "    torch.use_deterministic_algorithms(True)"
        },
        {
          "line": 28,
          "text": "    tensora = torch.randn(64, 3, 64, 64, dtype=torch.float, device=\"npu:0\")"
        },
        {
          "line": 29,
          "text": "    tensorsum = torch.sum(tensora)"
        },
        {
          "line": 30,
          "text": "    index = 0"
        },
        {
          "line": 31,
          "text": "    for i in range(100):"
        },
        {
          "line": 32,
          "text": "        res = torch.sum(tensora)"
        },
        {
          "line": 33,
          "text": "        if (res == tensorsum):"
        },
        {
          "line": 34,
          "text": "            index = index + 1"
        },
        {
          "line": 35,
          "text": "    if (index != 100):"
        },
        {
          "line": 36,
          "text": "        raise AssertionError(\"failed to test_npu_set_deterministic_true!\")"
        },
        {
          "line": 37,
          "text": ""
        },
